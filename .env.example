# PayLens Solo Environment Configuration
# AMD Hackathon Act III - Track 3 (Reinvent Commerce)

# Primary Endpoint: AMD Instinct MI300X vLLM Server (via SSH Tunnel or Cloudflare Quick Tunnel)
# Note: Localhost endpoints cannot be reached from Streamlit Community Cloud.
AMD_VLLM_BASE_URL=

# Backup Endpoint: AMD TokenFactory Zero-Billing Hackathon Endpoint
AMD_TOKENFACTORY_BASE_URL=
AMD_API_KEY=
MODEL_NAME=

# Hardware label (optional, only used for OWN_VLLM)
HARDWARE_LABEL=

# Evolus AI Partner Track Configuration (optional / in progress)
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=

# Action Execution & Webhooks (simulated demo)
MERCHANT_WEBHOOK_URL=

# Data & Database
DUCKDB_PATH=data/generated/paylens.duckdb

# Operational Mode
OFFLINE_MODE=false
DEFAULT_RECOVERY_RATE=0.35
SEASONAL_PERIODS=7
STL_SIGMA_THRESHOLD=2.2
