# PayLens Solo Environment Configuration
# AMD Hackathon Act III - Track 3 (Reinvent Commerce) + Evolus AI Partner Track

# Primary Endpoint: AMD MI300X vLLM Server (via SSH Tunnel or Cloudflare Quick Tunnel)
AMD_VLLM_BASE_URL=http://localhost:8000/v1
AMD_VLLM_MODEL=google/gemma-4-31B-it

# Backup Endpoint: AMD TokenFactory Zero-Billing Hackathon Endpoint
AMD_TOKENFACTORY_BASE_URL=https://notebooks.amd.com/tokenfactory/v1
AMD_API_KEY=mock-key-for-local-dev

# Hugging Face Token (for Gemma 4 license access on host)
HF_TOKEN=hf_replace_me

# Evolus AI Partner Track Configuration (https://app.evolus.ai)
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_WORKFLOW_ID=

# Action Execution & Webhooks
MERCHANT_WEBHOOK_URL=

# Data & Database
DUCKDB_PATH=data/generated/paylens.duckdb

# Operational Mode
OFFLINE_MODE=true
DEFAULT_RECOVERY_RATE=0.35
SEASONAL_PERIODS=7
STL_SIGMA_THRESHOLD=2.2
